# ---------- IBM Db2 (matches docker-compose.yml) ----------
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=PAYGUARD
DB2_USER=db2inst1
DB2_PASSWORD=
# Set to true for Db2 on IBM Cloud (port is usually 30xxx with SSL)
DB2_SSL=false
DB2_POOL_MIN=2
DB2_POOL_MAX=10
DB2_POOL_TIMEOUT=5
DB2_CONNECT_TIMEOUT=5
DB2_QUERY_TIMEOUT=3

# ---------- AI (optional - app falls back to rules without it) ----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=5
INVESTIGATION_TIMEOUT=10
# local = offline hashing embeddings (default, tuned thresholds); gemini = gemini-embedding-001
EMBED_PROVIDER=local
EMBED_DIM=768

# Bounded, process-local caches; do not cache verdicts or checkout decisions.
CACHE_SIZE=512
ENTITY_CACHE_TTL=5
PATTERN_CACHE_TTL=10
EMBEDDING_CACHE_TTL=60
RATE_LIMIT_PER_MINUTE=60
# Never put this server-to-server key in browser JavaScript.
PLATFORM_API_KEY=
PLATFORM_DEMO_ENABLED=true
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---------- PayPal sandbox (optional - enables protected checkout) ----------
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD

# ---------- Risk thresholds (0-100) ----------
REVIEW_THRESHOLD=35
BLOCK_THRESHOLD=65
